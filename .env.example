# ---- AUTH SWITCH (the "true/false thing") ----
# true  = no login, mock users + role switcher in the UI (for testing)
# false = real Firebase ID-token verification (needs a service account)
AUTH_DISABLED=true
# ---- DATA SWITCH ----
# false = in-memory demo data (resets on restart). true = real Cloud Firestore
USE_FIRESTORE=false
# Firebase Admin credentials (only when AUTH_DISABLED=false or USE_FIRESTORE=true). Use ONE of:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON=   # the whole key file pasted as one value (handy on Render). Takes priority over the file.
CORS_ORIGINS=http://localhost:8000
# ---- FIRST LOGIN (only when AUTH_DISABLED=false) ----
# pending = unknown Firebase accounts get a disabled 'caller' profile an admin must approve
# reject  = unknown accounts get no profile at all
FIRST_LOGIN_POLICY=pending
# Comma-separated emails that become ACTIVE admins on first login (Firebase email must be verified).
# Needed once, so the first admin can exist on an empty Firestore. Remove after setup if you like.
BOOTSTRAP_ADMIN_EMAILS=
# ---- APOLLO (server-side only, never in the frontend). Empty = Apollo features show "pending configuration" ----
APOLLO_API_KEY=
APOLLO_BULK_PAUSE=0.3        # seconds between enrichment batches (be gentle with Apollo's per-minute limits)
# ---- AI ASSISTANT: gemini | groq | none. Empty/none = rule-based answers + "AI provider pending configuration" ----
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# ---- OTHER ----
MAX_UPLOAD_MB=5
CRON_SECRET=                # set a long random value; the scheduler sends it as X-Cron-Secret
SCHEDULE_HOURS=8,13,18      # server-local hours shown as "next run"
